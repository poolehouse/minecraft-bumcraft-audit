# =====================================================================
# Bumcraft Minecraft Server — environment variables
# Copy this file to .env and fill in real values. NEVER commit .env.
# =====================================================================

# --- CurseForge (AUTO_CURSEFORGE modpack downloads) ---
# Get a free key at: https://console.curseforge.com/
CF_API_KEY=

# --- RCON (remote console) ---
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=CHANGE_ME_ROTATE_BEFORE_DEPLOY

# --- Ollama / AI builder ---
OLLAMA_BASE_URL=http://localhost:11434/v1
MODEL_NAME=qwen3-coder-next

# --- RCON HTTP API (mc_rcon_api.py) ---
API_HOST=0.0.0.0
API_PORT=8090

# --- JVM ---
# MEMORY=24G  # set in docker-compose; consider right-sizing to 8-12G